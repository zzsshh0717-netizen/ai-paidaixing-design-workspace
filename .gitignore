# 本机与编辑器配置
.vscode/
/.agents/*
!/.agents/.gitkeep
.playwright-cli/
canvas/

# 个人资料、工作流、临时资料与运行记录
/_本地私密资料-不要上传/*
!/_本地私密资料-不要上传/.gitkeep
/05-AI工作流/*
!/05-AI工作流/.gitkeep
/99-临时资料/*
!/99-临时资料/.gitkeep
**/.state/
**/运行日志/
**/*.log

# 真实视觉项目和复盘案例：公开仓库只保留空目录
/01-视觉方案/*
!/01-视觉方案/.gitkeep
!/01-视觉方案/00-示例项目-天猫-封闭式猫砂盆-详情页/
!/01-视觉方案/00-示例项目-天猫-封闭式猫砂盆-详情页/**
/04-复盘案例/*
!/04-复盘案例/.gitkeep
!/04-复盘案例/复盘模板.md

# 不公开下载参考图库；公开时仅保留自行拥有版权或明确获授权的素材
